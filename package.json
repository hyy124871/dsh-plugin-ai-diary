{
  "name": "dsh-plugin-ai-diary",
  "version": "0.9.7",
  "description": "AI 日记工坊：素材库 / 成片管理 / 发布与评论 / DeepSeek 自主选材 / 定时出片与定时发布，选题 + 本地渲染引擎（6 套模板 / 6 套动态底板 / 8 角色共 126 套立绘）+ 三家 TTS 配音 + MiniMax H3 视频底板 + 哔哩哔哩客户端投稿与评论自动化（内置电脑操控引擎），为 9:16 竖屏 AI 角色短剧而生",
  "icon": "./assets/icon.svg",
  "displayName": "AI 日记工坊",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./engine": "./src/engine.mjs",
    "./topics": "./src/topics.mjs",
    "./script": "./src/script.mjs",
    "./voice": "./src/voice.mjs",
    "./hailuo": "./src/hailuo.mjs",
    "./local": "./src/local.mjs",
    "./motion": "./src/motion.mjs",
    "./update": "./src/update.mjs",
    "./publish": "./src/publish.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./settings": "./src/settings.mjs",
    "./scheduler": "./src/scheduler.mjs",
    "./studio": "./src/studio.mjs",
    "./llm": "./src/llm.mjs",
    "./bili-login": "./src/bili-login.mjs"
  },
  "bin": {
    "ai-diary": "bin/ai-diary.mjs"
  },
  "files": [
    "assets/**",
    "src",
    "lib",
    "bin",
    "scripts",
    "data",
    "assets",
    "skills",
    "config",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "PROMPTS-VIDEO.md",
    "PROJECT-INTRO.md",
    "LICENSE",
    "publish-github.ps1",
    "test-voice.mjs",
    "test-providers.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "ai",
    "short-video",
    "bilibili",
    "render",
    "tts",
    "minimax-h3",
    "comfyui",
    "self-update",
    "settings",
    "scheduler"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "topics": "node bin/ai-diary.mjs topics --count 3",
    "plan:all": "node bin/ai-diary.mjs plan --all",
    "render:demo": "node bin/ai-diary.mjs plan --topic day7-balance && node bin/ai-diary.mjs render --script out/day7-balance.json",
    "voice:check": "node bin/ai-diary.mjs voice --check",
    "pack": "npm pack",
    "test": "node bin/ai-diary.mjs assets && node bin/ai-diary.mjs topics --count 2 && node test-providers.mjs && node test-voice.mjs",
    "settings": "node bin/ai-diary.mjs settings",
    "schedule": "node bin/ai-diary.mjs schedule"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@napi-rs/canvas": "^1.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
